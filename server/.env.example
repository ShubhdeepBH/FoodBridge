# FoodBridge Server Environment Configuration Example
# Copy this file to .env and configure values as needed

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/foodbridge?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# JSON Web Token (JWT) Configuration
# Generate a strong, random 256-bit secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
